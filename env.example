# Copy this file to ".env" for LOCAL development only.
# When deployed on Render, these same settings live in the Render
# dashboard's Environment tab instead (render.yaml pre-fills them).

# How often (seconds) to re-check GMP + subscription for OPEN IPOs.
GMP_REFRESH_SECONDS=300
SUBSCRIPTION_REFRESH_SECONDS=300

# Dates/issue size change rarely — refresh hourly.
METADATA_REFRESH_SECONDS=3600

# Comma-separated list of origins allowed to call the API.
# "*" is fine since this is a personal read-only tracker.
ALLOWED_ORIGINS=*

# Set to 1 to stop the backend from calling InvestorGain automatically
# (useful while testing without hitting the live site).
DISABLE_BACKGROUND_REFRESH=0

# Set to 1 to enable /api/debug/* diagnostic endpoints (raw InvestorGain
# report dumps, repo file paths, GitHub-persistence status, etc.). Leave
# at 0 in production -- these expose internal operational details with no
# authentication. Turn on locally (or briefly in Render's Environment tab)
# only when actively debugging a live data issue, then turn back off.
DEBUG_ENDPOINTS_ENABLED=0
