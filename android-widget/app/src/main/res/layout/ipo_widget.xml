<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IPOAbhi"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#18212B" />
            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updating…"
                android:textSize="11sp"
                android:textColor="#77808C" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/refresh_bg"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh IPO data" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="Loading IPOs…"
        android:textSize="14sp"
        android:textColor="#5F6975"
        android:gravity="center"
        android:visibility="gone" />

    <ListView
        android:id="@+id/ipo_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:scrollbars="none" />
</LinearLayout>
